// Prisma Schema for Kumpul (RCT Apps)
// Based on architecture.md and schema.md specifications

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum GroupType {
  PUBLIC
  VIP
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  KICKED
  BANNED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  DELETED
}

enum VIPRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  VIP_REQUEST_SUBMITTED
  VIP_REQUEST_APPROVED
  VIP_REQUEST_REJECTED
  REMOVED_FROM_GROUP
  MENTION
  SYSTEM
}

enum AttachmentPurpose {
  MESSAGE
  USER_AVATAR
  GROUP_AVATAR
}

enum AttachmentStatus {
  PENDING
  READY
}

// ═══════════════════════════════════════════════════════════════════════════════
// USERS & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(254)
  username        String     @unique @db.VarChar(20)
  displayName     String     @map("display_name") @db.VarChar(40)
  passwordHash    String     @map("password_hash")
  avatarUrl       String?    @map("avatar_url")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastSeenAt      DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Relations
  refreshTokens       RefreshToken[]
  memberships         GroupMember[]
  sentMessages        Message[]         @relation("MessageSender")
  deletedMessages     Message[]         @relation("MessageDeleter")
  ownedGroups         Group[]           @relation("GroupOwner")
  createdGroups       Group[]           @relation("GroupCreator")
  createdInviteCodes  InviteCode[]
  vipRequests         VipGroupRequest[] @relation("VipRequester")
  reviewedVipRequests VipGroupRequest[] @relation("VipReviewer")
  notifications       Notification[]
  auditLogs           AuditLog[]
  unreadMessages      UnreadMessage[]

  @@index([status])
  @@index([email])
  @@index([username])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GROUPS & MEMBERSHIP
// ═══════════════════════════════════════════════════════════════════════════════

model Group {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @db.VarChar(50)
  slug          String      @unique @db.VarChar(64)
  description   String?     @db.VarChar(500)
  avatarUrl     String?     @map("avatar_url")
  type          GroupType   @default(PUBLIC)
  status        GroupStatus @default(ACTIVE)
  maxMembers    Int         @default(500) @map("max_members")
  memberCount   Int         @default(0) @map("member_count")
  inviteCode    String?     @unique @map("invite_code") @db.VarChar(16)
  ownerId       String?     @map("owner_id") @db.Uuid
  createdById   String      @map("created_by_id") @db.Uuid
  lastMessageId BigInt?     @map("last_message_id") // Denormalized, no FK
  lastMessageAt DateTime?   @map("last_message_at") @db.Timestamptz(6)
  archivedAt    DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relations
  owner         User?             @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       GroupMember[]
  messages      Message[]
  inviteCodes   InviteCode[]
  sourceRequest VipGroupRequest?  @relation("RequestCreatedGroup")

  @@index([type, status, deletedAt])
  @@index([ownerId])
  @@index([slug])
  @@index([inviteCode])
  @@index([lastMessageAt(sort: Desc)])
  @@map("groups")
}

model GroupMember {
  groupId           String         @map("group_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  role              GroupMemberRole @default(MEMBER)
  status            MemberStatus   @default(ACTIVE) 
  isMuted           Boolean        @default(false) @map("is_muted")
  lastReadMessageId BigInt?        @map("last_read_message_id")
  bannedReason      String?        @map("banned_reason") @db.VarChar(200)
  joinedAt          DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt            DateTime?      @map("left_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status, role])
  @@map("group_members")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MESSAGES
// ═══════════════════════════════════════════════════════════════════════════════

model Message {
  id              BigInt        @id @default(autoincrement())
  groupId         String        @map("group_id") @db.Uuid
  senderId        String?       @map("sender_id") @db.Uuid // NULL for SYSTEM messages
  type            MessageType   @default(TEXT)
  status          MessageStatus @default(SENT)
  content         String?       // NULL when deleted
  replyToId       BigInt?       @map("reply_to_id")
  clientMessageId String?       @map("client_message_id") @db.Uuid // For idempotency
  mentions        String[]      @default([]) @db.Uuid
  metadata        Json?         // For system messages
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedById     String?       @map("deleted_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User?     @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  deletedBy User?     @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  @@unique([senderId, clientMessageId], name: "uq_sender_client_message_id")
  @@index([groupId, id(sort: Desc)], name: "idx_messages_group_timeline")
  @@index([senderId])
  @@index([replyToId])
  @@index([status])
  @@index([deletedAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VIP REQUESTS
// ═══════════════════════════════════════════════════════════════════════════════

model VipGroupRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  requesterId        String           @map("requester_id") @db.Uuid
  groupName          String           @map("group_name") @db.VarChar(50)
  description        String?          @db.VarChar(500)
  purpose            String           @db.VarChar(1000)
  estimatedMembers   Int              @map("estimated_members")
  status             VIPRequestStatus @default(PENDING)
  reviewedById       String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  adminNotes         String?          @map("admin_notes") @db.VarChar(500)
  approvedMaxMembers Int?             @map("approved_max_members")
  createdGroupId     String?          @unique @map("created_group_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester    User   @relation("VipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer     User?  @relation("VipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdGroup Group? @relation("RequestCreatedGroup", fields: [createdGroupId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("vip_group_requests")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVITE CODES  
// ═══════════════════════════════════════════════════════════════════════════════

model InviteCode {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  code        String    @unique @db.VarChar(10)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  maxUses     Int?      @map("max_uses")
  useCount    Int       @default(0) @map("use_count")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([code])
  @@map("invite_codes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String?          @db.VarChar(500)
  data      Json?            // Context data (groupId, requestId, etc.)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt]) // For unread notifications
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  targetType String?  @map("target_type") @db.VarChar(50)
  details    Json?    // Sanitized change details
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// UNREAD TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

model UnreadMessage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  lastReadAt    DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)
  unreadCount   Int      @default(0) @map("unread_count")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("unread_messages")
}