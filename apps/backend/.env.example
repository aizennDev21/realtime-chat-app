# Database
DATABASE_URL="postgresql://kumpul_user:kumpul_password@localhost:5432/kumpul_db"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT & Authentication
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-change-in-production"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-in-production"
REFRESH_TTL_DAYS="30"

# Server
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Security (Argon2id)
ARGON2_MEMORY_COST="65536"
ARGON2_TIME_COST="3"  
ARGON2_PARALLELISM="4"

# Cookies
COOKIE_DOMAIN=""

# File Storage (S3/MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="kumpul-storage"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_BASE_URL="http://localhost:9000"

# Real-time Settings
PRESENCE_MAX_GROUP_SIZE="500"
TYPING_TIMEOUT_MS="5000"
SOCKET_TIMEOUT_MS="30000"

# Business Rules
MESSAGE_MAX_LENGTH="4000"
MESSAGE_EDIT_WINDOW_MS="900000"
VIP_REQUEST_MAX_PENDING="1"
VIP_REQUEST_MAX_ACTIVE="3"
VIP_REQUEST_COOLDOWN_MS="86400000"
GROUP_MEMBER_LIMIT_DEFAULT="500"
GROUP_MEMBER_LIMIT_MAX="1000"

# Admin (for seeding)
ADMIN_EMAIL="admin@kumpul.local"
ADMIN_PASSWORD="admin123456"

# Logging
LOG_LEVEL="debug"

# Email (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@kumpul.app"