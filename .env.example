# Database
DATABASE_URL=postgresql://kumpul_user:kumpul_password@localhost:5432/kumpul_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kumpul_db
DB_USER=kumpul_user
DB_PASSWORD=kumpul_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MESSAGES=kumpul-messages
MINIO_BUCKET_AVATARS=kumpul-avatars

# Backend
NODE_ENV=development
PORT=3000
HOST=localhost
API_URL=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRY=30d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
